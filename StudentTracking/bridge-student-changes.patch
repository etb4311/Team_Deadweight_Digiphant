+class RestartingTaskTests(unittest.TestCase):
+    def test_graph_error_restarts_task_instead_of_stopping(self):
+        made = []
+        class Task:
+            def __init__(self):
+                self.fail, self.closed = not made, False
+                made.append(self)
+            def recognize(self, frame):
+                if self.fail:
+                    raise RuntimeError("Packet isn't the sole owner of the holder.")
+                return frame
+            def close(self):
+                self.closed = True
+                if self.fail:
+                    raise RuntimeError('graph already failed')
+        task = RestartingTask(Task, retry_seconds=0)
+        self.assertIsNone(task.run('recognize', 1))
+        self.assertTrue(made[0].closed)
+        self.assertEqual(task.run('recognize', 2), 2)
+        self.assertEqual(len(made), 2)
+        task.close()
+        self.assertTrue(made[1].closed)
+
+
 if __name__ == '__main__':
     unittest.main()
