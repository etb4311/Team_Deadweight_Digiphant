+def nearest_wrist(point, wrists, max_distance):
+    """Return the (slot, side) key of the closest pose wrist within max_distance, else None."""
+    best = min(wrists, key=lambda k: math.dist(point, wrists[k]), default=None)
+    return best if best is not None and math.dist(point, wrists[best]) <= max_distance else None
+
+
+class RestartingTask:
+    """Optional MediaPipe task that is rebuilt after an internal graph error instead of
+    stopping performer tracking. A failed graph cannot be reused, so it is replaced."""
+    def __init__(self, create, retry_seconds=1.0):
+        self.create, self.retry_seconds = create, retry_seconds
+        self.task, self.retry_at = create(), 0.0
+
+    def run(self, method, *args):
+        now = time.monotonic()
+        if self.task is None:
+            if now < self.retry_at:
+                return None
+            self.task = self.create()
+        try:
+            return getattr(self.task, method)(*args)
+        except RuntimeError as error:
+            print(f'{type(self.task).__name__} failed; restarting it. ({str(error).splitlines()[-1]})')
+            self.close()
+            self.retry_at = now + self.retry_seconds
+            return None
+
+    def close(self):
+        task, self.task = self.task, None
+        if task is not None:
+            try:
+                task.close()
+            except RuntimeError:
+                pass  # closing a failed graph re-raises its original error
+
+
+def send_quietly(sender, data, port):
+    """Optional packets may be dropped; they must never stop performer tracking."""
+    try:
+        sender.sendto(data, ('127.0.0.1', port))
+    except OSError as error:
+        if error.errno not in (errno.EMSGSIZE, errno.EAGAIN, errno.EWOULDBLOCK, errno.ENOBUFS):
+            raise
+
